{
  "name": "codeview",
  "version": "1.2.1",
  "description": "A native macOS code and markdown editor with integrated terminal",
  "main": "main.js",
  "repository": { "type": "git", "url": "https://github.com/dkeg/codeview.git" },
  "author": "dkeg",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty --arch=$(node -e 'console.log(process.arch)')",
    "build": "npm run rebuild && electron-builder --mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.16",
    "marked": "^4.3.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.codeview.app",
    "productName": "CodeView",
    "directories": { "output": "dist" },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon-dark.icns",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "fileAssociations": [
        { "ext": "md",       "name": "Markdown File",    "role": "Editor" },
        { "ext": "json",     "name": "JSON File",        "role": "Editor" },
        { "ext": "html",     "name": "HTML File",        "role": "Editor" },
        { "ext": "js",       "name": "JavaScript File",  "role": "Editor" },
        { "ext": "ts",       "name": "TypeScript File",  "role": "Editor" },
        { "ext": "py",       "name": "Python File",      "role": "Editor" },
        { "ext": "yaml",     "name": "YAML File",        "role": "Editor" },
        { "ext": "yml",      "name": "YAML File",        "role": "Editor" },
        { "ext": "sh",       "name": "Shell Script",     "role": "Editor" },
        { "ext": "txt",      "name": "Text File",        "role": "Editor" }
      ]
    },
    "files": [
      "main.js", "preload.js", "renderer.js", "globals.js", "icons.js", 
      "terminal.js", "git.js", "file-tree.js", "settings.js", "tabs.js", 
      "editor-manager.js", "preview.js", "index.html", "styles.css",
      "node_modules/codemirror/**",
      "node_modules/@xterm/**",
      "node_modules/node-pty/**",
      "node_modules/marked/**",
      "assets/**"
    ]
  }
}
